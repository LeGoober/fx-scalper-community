# ─────────────────────────────────────────────
# FX Scalper (ICT × Jev × Deriv) — Configuration
# ─────────────────────────────────────────────
# Copy to .env (never commit it):  cp .env.example .env
# Keys can also be set from the UI (Settings → API keys); they are write-only.

# ── Server (localhost only by default: this API manages broker keys) ──
COMMUNITY_HOST=127.0.0.1
COMMUNITY_PORT=5001

# ── Deriv ─────────────────────────────────────
# Token: app.deriv.com → API token. Scopes: Read + Trade ONLY (never Payments/Admin).
COMMUNITY_DERIV_APP_ID=1089
COMMUNITY_DERIV_TOKEN=

# Real-money unlock. Leave false. Only a hand edit here can enable it, and the
# UI must still arm it per session. Demo is enforced at order time otherwise.
COMMUNITY_ALLOW_REAL_TRADING=false

# ── Jev (TypeSafe System One) ─────────────────
TYPESAFE_API_KEY=
# Pin a version for reproducible backtests (e.g. jev-1.13.0); jev-latest floats.
COMMUNITY_JEV_MODEL=jev-latest

# ── TradingView webhooks ──────────────────────
# Generate via UI (Settings → TradingView → Rotate secret).
COMMUNITY_TV_WEBHOOK_SECRET=

# ── OpenBB data providers (optional; yfinance + ForexFactory work without keys) ──
FMP_API_KEY=
FRED_API_KEY=
TIINGO_TOKEN=

# ── Notifications (optional) ──────────────────
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
